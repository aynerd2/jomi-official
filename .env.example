# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# MongoDB connection string. A free MongoDB Atlas cluster is enough for development.
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jomi
MONGODB_URI=mongodb+srv://aynerdscholarship_db_user:vMpV2jCCbjqRX7Kz@shepherdcluster.h5u3grc.mongodb.net/?appName=shepherdcluster

# Signs Payload auth tokens. Generate one with: openssl rand -base64 32
# Changing it signs every admin user out.
PAYLOAD_SECRET=HJA/DmN6EXZf2f3d0xrUAMlXCFUDk/o/+E0F5gI9Z3I=

# The site's own origin, used for CORS and absolute URLs.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudinary holds the uploads (leader photos, gallery, sermon thumbnails, book
# covers). All three come from the Cloudinary console, under
# Settings > API Keys / the Product Environment Credentials panel on the dashboard.
# Without these three, uploads fall back to public/media on local disk.
CLOUDINARY_CLOUD_NAME=dq8jo2bf7
CLOUDINARY_API_KEY=687157961828233
CLOUDINARY_API_SECRET=Pbh1U4aEK4wXOQFgj1TNzCeBAQ4
# Optional. The folder every upload is filed under. Defaults to "jomi".
CLOUDINARY_FOLDER=

# Paystack (Naira giving). Test keys start sk_test_ / pk_test_.
# The secret key must never be exposed to the browser.
PAYSTACK_SECRET_KEY=sk_test_08413273cd31a158f9317e6bf3a7c455da3f7511
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_d5ec506f6f876a4fe3447f325642da34460bd827
